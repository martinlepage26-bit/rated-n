{
  "name": "rated-n",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "npm run build:frontend && wrangler pages dev -c wrangler.jsonc -c worker/wrangler.jsonc",
    "build": "npm run typecheck && npm run build:frontend",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:types": "wrangler types --config worker/wrangler.jsonc worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply rated-n-db --local --config worker/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply rated-n-db --remote --config worker/wrangler.jsonc",
    "deploy:api": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy:web": "wrangler pages deploy dist --project-name rated-n"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.111.0"
  }
}
